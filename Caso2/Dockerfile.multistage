# Dockerfile multistage - separa la etapa de construccion (instalacion de dependencias)
# de la etapa final de ejecucion, para que la imagen final solo contenga lo necesario
# para correr la aplicacion, sin cache ni artefactos intermedios de pip.

# ---------- Etapa 1: builder ----------
FROM python:3.12-slim AS builder

WORKDIR /app

COPY requirements.txt .
# Se instalan las dependencias en /install para copiarlas limpias a la etapa final
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---------- Etapa 2: runtime ----------
FROM python:3.12-slim

WORKDIR /app

# Se copian unicamente las dependencias ya instaladas, no la cache ni herramientas de la etapa builder
COPY --from=builder /install /usr/local

COPY app.py .
COPY templates/ templates/

RUN useradd --create-home appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 5000

CMD ["python", "app.py"]
