# Dockerfile optimizado - una sola etapa, pero con buenas practicas:
#  - imagen base "slim" (mucho mas liviana que python:3.12 completa)
#  - capas ordenadas para aprovechar la cache de Docker (dependencias antes que el codigo)
#  - limpieza del cache de apt y de pip para reducir el tamano final
#  - usuario no root para ejecutar la aplicacion
FROM python:3.12-slim

WORKDIR /app

# Dependencias del sistema (ffmpeg es necesario para unir audio/video de yt-dlp)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Dependencias de Python en su propia capa: solo se reinstalan si requirements.txt cambia
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Codigo de la aplicacion
COPY app.py .
COPY templates/ templates/

# Usuario sin privilegios de root
RUN useradd --create-home appuser && \
    mkdir -p /app/downloads && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 5000

CMD ["python", "app.py"]
